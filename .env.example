# Variables de entorno de EarlySign.
# Copiar a `.env` y completar. NUNCA versionar el `.env` real.

# --- Supabase ---
# URL base del proyecto SIN el sufijo /rest/v1 (la API lo normaliza si viene pegado).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publica (anon). Se usa junto con el JWT del usuario para que aplique RLS.
SUPABASE_ANON_KEY=TU_CLAVE_ANON
# Clave de servicio: SOLO servidor (migraciones, scripts de semilla). NO va al navegador.
SUPABASE_SERVICE_ROLE_KEY=TU_CLAVE_SERVICE_ROLE
# Opcional: solo para proyectos Supabase antiguos que firman el JWT con HS256.
# SUPABASE_JWT_SECRET=

# --- API ---
API_ENV=development
# Orígenes permitidos (CORS), separados por coma.
CORS_ORIGINS=http://localhost:4200,http://localhost:8501
# Tolerancia (segundos) al validar el JWT: absorbe el desfase del reloj local
# respecto al servidor de Supabase (se han medido ~4 minutos).
JWT_LEEWAY_SECONDS=300

# --- Usuario de prueba (desarrollo / k6) ---
TEST_USER_EMAIL=orientador@alertatemprana.pe
TEST_USER_PASSWORD=cambia-esta-clave

# --- Migraciones (opcional) ---
# Con una de estas dos, `scripts/apply_migrations.py` aplica el SQL solo.
# SUPABASE_ACCESS_TOKEN=pat_...          # Personal Access Token (Management API)
# SUPABASE_DB_URL=postgresql://...        # conexion directa a Postgres
